generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  SUSPENDED
  CLOSED
  EXPIRED
}

enum JobModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkModel {
  ONSITE
  HYBRID
  REMOTE
}

enum ResumeStatus {
  READY
  REJECTED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

enum CompanyMemberRole {
  OWNER
  MEMBER
}

model User {
  id                String            @id @default(uuid()) @db.Uuid
  email             String            @unique @db.VarChar(320)
  passwordHash      String            @map("password_hash") @db.VarChar(255)
  role              UserRole          @default(CANDIDATE)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  candidateProfile  CandidateProfile?
  resumes           Resume[]
  applications      Application[]
  sessions          Session[]
  companyMemberships CompanyMember[]
  moderatedJobs     Job[]             @relation("JobModerationActor")
  auditLogs         AuditLog[]
  savedJobs         SavedJob[]

  @@map("users")
}

model CandidateProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String   @map("display_name") @db.VarChar(160)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model Resume {
  id           String       @id @default(uuid()) @db.Uuid
  candidateId  String       @map("candidate_id") @db.Uuid
  originalName String       @map("original_name") @db.VarChar(255)
  storageKey   String       @unique @map("storage_key") @db.VarChar(512)
  mimeType     String       @map("mime_type") @db.VarChar(100)
  sizeBytes    Int          @map("size_bytes")
  content      Bytes?       @db.ByteA
  storageProvider String    @default("postgres") @map("storage_provider") @db.VarChar(32)
  checksumSha256 String?    @map("checksum_sha256") @db.Char(64)
  version      Int          @default(1)
  status       ResumeStatus @default(READY)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  candidate    User         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([candidateId, status])
  @@map("resumes")
}

model Job {
  id           String      @id @default(uuid()) @db.Uuid
  title        String      @db.VarChar(180)
  companyName  String      @map("company_name") @db.VarChar(180)
  location     String      @db.VarChar(180)
  category     String?     @db.VarChar(120)
  workModel    WorkModel   @default(ONSITE) @map("work_model")
  salaryMin    Int?        @map("salary_min")
  salaryMax    Int?        @map("salary_max")
  salaryCurrency String?   @map("salary_currency") @db.Char(3)
  description  String      @db.Text
  status       JobStatus   @default(DRAFT)
  moderationStatus JobModerationStatus @default(PENDING) @map("moderation_status")
  moderationReason String? @map("moderation_reason") @db.VarChar(1000)
  moderatedAt  DateTime?  @map("moderated_at")
  moderatedBy  String?     @map("moderated_by") @db.Uuid
  publishedAt  DateTime?   @map("published_at")
  expiresAt    DateTime?   @map("expires_at")
  companyId    String?     @map("company_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  applications Application[]
  savedByCandidates SavedJob[]
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  moderationActor User?     @relation("JobModerationActor", fields: [moderatedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedAt])
  @@index([expiresAt])
  @@index([location])
  @@index([category])
  @@index([workModel])
  @@index([companyId, status])
  @@index([status, moderationStatus])
  @@map("jobs")
}

model Company {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @db.VarChar(180)
  location  String?         @db.VarChar(180)
  industry  String?         @db.VarChar(120)
  about     String?         @db.Text
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  members   CompanyMember[]
  jobs      Job[]

  @@map("companies")
}

model CompanyMember {
  id        String            @id @default(uuid()) @db.Uuid
  companyId String            @map("company_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  role      CompanyMemberRole @default(MEMBER)
  createdAt DateTime          @default(now()) @map("created_at")
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

model Application {
  id                        String            @id @default(uuid()) @db.Uuid
  jobId                     String            @map("job_id") @db.Uuid
  candidateId               String            @map("candidate_id") @db.Uuid
  resumeId                  String            @map("resume_id") @db.Uuid
  resumeSnapshotName        String            @map("resume_snapshot_name") @db.VarChar(255)
  resumeSnapshotVersion     Int               @map("resume_snapshot_version")
  resumeSnapshotMimeType    String            @map("resume_snapshot_mime_type") @db.VarChar(100)
  resumeSnapshotSizeBytes   Int               @map("resume_snapshot_size_bytes")
  status                    ApplicationStatus @default(SUBMITTED)
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")
  job                       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate                 User              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  resume                    Resume            @relation(fields: [resumeId], references: [id], onDelete: Restrict)

  @@unique([jobId, candidateId])
  @@index([candidateId, createdAt])
  @@index([jobId, status])
  @@map("applications")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(80)
  resourceId   String?  @map("resource_id") @db.Uuid
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model SavedJob {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate   User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([candidateId, createdAt])
  @@index([jobId])
  @@map("saved_jobs")
}

model RateLimitWindow {
  action           String   @db.VarChar(80)
  subjectId        String   @map("subject_id") @db.Uuid
  windowStartedAt DateTime @map("window_started_at")
  count            Int      @default(0)

  @@id([action, subjectId, windowStartedAt])
  @@index([windowStartedAt])
  @@map("rate_limit_windows")
}
