# PostgreSQL / Prisma
# Replace user, password, host, port and database name for your local environment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexspacey?schema=public&sslmode=disable"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3003"

# Authentication (configure after selecting the auth provider)
# AUTH_SECRET="replace-with-a-long-random-secret"
# AUTH_TRUST_HOST="true"
# RESUME_SIGNING_SECRET="replace-with-a-long-random-secret"

# Object storage for private resumes and company logos (configure when uploads are implemented)
# RESUME_STORAGE_PROVIDER="postgres"
# R2_ACCOUNT_ID=""
# R2_BUCKET="nexspacey-private"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="ap-southeast-1"
# S3_BUCKET="nexspacey-private"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# Resume malware scanning (production requires ClamAV)
# RESUME_MALWARE_SCANNER="clamav"
# CLAMAV_HOST="clamav"
# CLAMAV_PORT="3310"
# CLAMAV_TIMEOUT_MS="10000"

# Observability (configure when monitoring is implemented)
# SENTRY_DSN=""
